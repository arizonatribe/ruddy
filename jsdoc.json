{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": [
      "jsdoc"
    ]
  },
  "plugins": [
    "plugins/markdown"
  ],
  "source": {
    "includePattern": ".js$",
    "excludePattern": "(node_modules/|docs)",
    "include": [
      "src",
      "package.json",
      "README.md"
    ]
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false,
    "search": true,
    "navLinks": [
      {
        "label": "Github",
        "href": "https://github.com/arizonatribe/ruddy"
      }
    ],
    "better-docs": {
      "name": "Ruddy",
      "title": "Modularized state-management tools for modern front-end applications",
      "navigation": [
        {
          "label": "Github",
          "href": "https://github.com/arizonatribe/ruddy"
        }
      ]
    }
  },
  "opts": {
    "destination": "./docs/",
    "encoding": "utf8",
    "recurse": true,
    "template": "node_modules/better-docs"
  }
}
