{
  "name": "ruddy",
  "description": "Modularized state-management tools for modern front-end applications. Manage dispatched messages in a clean and predictable way for either small or large scale projects",
  "main": "cjs/index.js",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "authors": [
    "Andre Aizim Kelmanson (pre-fork 'extensible-duck' author) <akelmanson@gmail.com>",
    "David Nunez <arizonatribe@gmail.com>"
  ],
  "homepage": "https://arizonatribe.github.io/ruddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/arizonatribe/ruddy.git"
  },
  "keywords": [
    "ruddy",
    "javascript",
    "shapey",
    "spected",
    "ramda",
    "redux",
    "reducer",
    "machine",
    "state",
    "functional",
    "worker",
    "enhancer",
    "multiplier",
    "selector",
    "creator",
    "types",
    "middleware",
    "duckware",
    "ducks",
    "duck",
    "dux"
  ],
  "watch": {
    "docs": "src/*"
  },
  "scripts": {
    "dist": "npm publish build",
    "docs": "rimraf docs/* && jsdoc --configure jsdoc.json && mv docs/$npm_package_name/$npm_package_version/* docs/ && rimraf docs/$npm_package_name",
    "start": "npm run test:watch",
    "test:watch": "nodemon test/index.js",
    "test": "tape --require=@babel/register test/index.js",
    "lint": "eslint src test scripts",
    "format": "eslint --fix src test scripts",
    "prepare": "npm run build",
    "build": "node scripts/build",
    "predeploy": "npm run docs",
    "deploy": "gh-pages -d docs"
  },
  "dependencies": {
    "ramda": "0.29.0",
    "shapey": "1.0.7",
    "spected": "0.6.0",
    "workerize": "0.1.7"
  },
  "devDependencies": {
    "@babel/cli": "7.0.0",
    "@babel/core": "7.0.0",
    "@babel/node": "7.0.0",
    "@babel/plugin-external-helpers": "7.0.0",
    "@babel/plugin-proposal-object-rest-spread": "7.0.0",
    "@babel/preset-env": "7.0.0",
    "@babel/preset-stage-0": "7.0.0",
    "@babel/register": "7.0.0",
    "@babel/runtime": "7.0.0",
    "@rollup/plugin-babel": "^5.2.1",
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-replace": "^2.3.3",
    "@typescript-eslint/eslint-plugin": "^4.12.0",
    "@typescript-eslint/parser": "^4.12.0",
    "babel-eslint": "8.2.1",
    "babel-plugin-add-module-exports": "^1.0.4",
    "babel-plugin-ramda": "2.1.1",
    "better-docs": "^2.0.0",
    "chalk": "2.4.1",
    "copyfiles": "^2.4.1",
    "cross-env": "5.1.0",
    "eslint": "^7.20.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-jsdoc": "^30.7.3",
    "faucet": "0.0.1",
    "fs-extra": "7.0.0",
    "gh-pages": "^3.2.3",
    "glob": "7.1.1",
    "jsdoc": "^3.6.7",
    "jsdoc-export-default-interop": "^0.3.1",
    "nodemon": "^2.0.9",
    "rimraf": "^3.0.0",
    "rollup": "~2.38.0",
    "rollup-plugin-terser": "^7.0.0",
    "tape": "4.9.1",
    "tape-promise": "3.0.0",
    "typescript": "^4.3.5"
  },
  "prettier": {
    "bracketSpacing": false,
    "parser": "babylon",
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false
  }
}
